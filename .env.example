# Copia este fichero a .env y ajusta los valores.

# Puerto del servidor 192.168.1.20 en el que escucha la app (el proxy apunta aquí).
PUERTO=3080

# Datos de la empresa: salen en la cabecera de la app y en los informes PDF.
EMPRESA_NOMBRE=Nombre de la empresa SL
EMPRESA_CIF=
EMPRESA_DIR=

# Zona horaria de la empresa. Todas las horas se muestran y agrupan en ella,
# aunque quien consulte esté en otro país.
TZ_EMPRESA=Europe/Madrid

# Días que dura abierta la sesión en el móvil del trabajador / del administrador.
SESION_DIAS_EMPLEADO=180
SESION_DIAS_ADMIN=7

# Horas máximas de antigüedad de un fichaje hecho sin conexión para aceptarlo al sincronizar.
OFFLINE_MAX_HORAS=72
